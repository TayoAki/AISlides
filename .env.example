# Copy to .env.local for local development. On Railway, set these as service variables.

# Public URL of the site (used for canonical links, sitemap, API URLs).
# On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite database and uploaded/generated images live. On Railway, mount a volume here.
DATA_DIR=./.data

# AI image provider. Set ONE key; without any key the app runs in clearly labeled demo mode.
# Replicate (recommended): FLUX Kontext Pro for edits, FLUX 1.1 Pro for text-to-image.
REPLICATE_API_TOKEN=
# OpenAI alternative (gpt-image-1 by default).
OPENAI_API_KEY=
# Optional: force a provider (replicate | openai | demo) and override models.
AI_PROVIDER=
REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro
REPLICATE_MULTI_MODEL=flux-kontext-apps/multi-image-kontext-pro
REPLICATE_TEXT_MODEL=black-forest-labs/flux-1.1-pro
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Free beta allowance per account per UTC day (protects your AI bill), and parallel renders.
FREE_DAILY_RENDERS=20
RENDER_CONCURRENCY=2

# Comma-separated emails that can open /app/admin (form submissions, stats).
ADMIN_EMAILS=
